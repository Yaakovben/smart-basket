# ===================================
# Smart Basket API Server - Environment Variables
# ===================================
# Copy this file to .env and fill in your values

# ─────────────────────────────────────
# Application Settings
# ─────────────────────────────────────
# Environment: development | production | test
# - development: shows error stack traces, disables Sentry
# - production: hides stack traces, enables Sentry
NODE_ENV=development

# Server port
PORT=5000

# ─────────────────────────────────────
# Database
# ─────────────────────────────────────
# MongoDB connection string
# Local: mongodb://localhost:27017/smartbasket
# Atlas: mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/<DATABASE>
MONGODB_URI=mongodb://localhost:27017/smartbasket

# ─────────────────────────────────────
# Authentication
# ─────────────────────────────────────
# JWT secrets - generate strong random strings (min 32 characters)
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=your-access-secret-key-min-32-characters-long
# JWT_REFRESH_SECRET is required at startup (env validation) but currently
# UNUSED by the actual refresh flow: the refresh token is a random string
# (not a JWT) stored in MongoDB with a hardcoded 40-day TTL, renewed on every
# successful refresh (see server/api/src/services/token.service.ts). Keep a
# value here so the server boots; it has no effect on session length.
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-characters-long

# Access token expiration (short-lived, refreshed automatically by the client)
JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN is likewise unused (see note above) - ignore it.
JWT_REFRESH_EXPIRES_IN=90d

# Google OAuth Client ID
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─────────────────────────────────────
# CORS
# ─────────────────────────────────────
# Allowed origins (comma-separated for multiple)
# Example: https://app.com,https://www.app.com
# WARNING: do NOT use CORS_ORIGIN=* in production — wildcard with credentials:true
# is rejected by browsers and exposes the API to cross-origin attacks.
CORS_ORIGIN=http://localhost:5173

# ─────────────────────────────────────
# Admin
# ─────────────────────────────────────
# This email gets admin privileges automatically on registration
ADMIN_EMAIL=admin@example.com

# ─────────────────────────────────────
# Error Monitoring (Optional)
# ─────────────────────────────────────
# Sentry DSN - get from sentry.io project settings
# Only sends errors when NODE_ENV=production
# SENTRY_DSN=https://xxxxx@oxxxxx.ingest.sentry.io/xxxxx

# ─────────────────────────────────────
# Logging (Optional)
# ─────────────────────────────────────
# Logtail (BetterStack) - cloud logging dashboard
# Get token from: https://logs.betterstack.com → Sources → Connect source
# Same token can be used for both API and Socket servers
# LOGTAIL_TOKEN=your-logtail-source-token

# ─────────────────────────────────────
# Push Notifications (Optional)
# ─────────────────────────────────────
# VAPID keys for web push. Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID subject - a contact address push providers (Google/Apple/Mozilla) can
# reach. Not a secret. Defaults to the project's public support email if unset.
# VAPID_EMAIL=mailto:your-support-email@example.com

# ─────────────────────────────────────
# Geocoding Fallback (Optional)
# ─────────────────────────────────────
# LocationIQ - fallback when Nominatim fails on Hebrew addresses.
# Free tier: 5,000 requests/day, no credit card. Get one at locationiq.com
# LOCATIONIQ_API_KEY=

# ─────────────────────────────────────
# Product Photos - Cloudinary (Optional)
# ─────────────────────────────────────
# Lets users attach a photo to a product. The browser sends a compressed
# image to POST /api/uploads/product-image; this server uploads it to
# Cloudinary using the API secret below and returns only the https URL.
# These are real secrets - server only, never exposed to the client.
# When unset, the endpoint returns 503 and the client falls back to storing
# a compressed data-URL inside the product document.
#
# Get all three from the Cloudinary dashboard (Settings → API Keys):
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ─────────────────────────────────────
# Email - Gmail API (Optional)
# ─────────────────────────────────────
# Sends email over the Gmail API on HTTPS (not SMTP - Render blocks SMTP
# ports). GMAIL_USER is the sending address; the other three come from a
# Google Cloud OAuth2 client (scope: gmail.send). See EMAIL_SETUP.md.
# If any is missing, sending email becomes a silent no-op.
# GMAIL_USER=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# ─────────────────────────────────────
# OCR - "Scan List Photo" Feature (Optional)
# ─────────────────────────────────────
# OCR.space API key, free tier, no credit card: ocr.space/ocrapi/freekey
# If missing, the endpoint returns a clear error instead of failing silently.
# OCR_API_KEY=

# ─────────────────────────────────────
# Redis (Optional)
# ─────────────────────────────────────
# Enables real-time cross-server events (e.g. a removed member's sockets
# get kicked immediately) to the socket server. If unset, the underlying
# DB writes still succeed - just without the immediate live effect.
# REDIS_URL=

# ─────────────────────────────────────
# AI Assistant - Groq (Optional)
# ─────────────────────────────────────
# OpenAI-compatible endpoint at console.groq.com, used for the spending
# assistant. If missing, the endpoint returns a clear error instead of
# silently trying without a key.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Global daily request budget across ALL users combined (0 = no cap).
# Tune this to the provider's real free-tier quota with a safety margin.
# AI_DAILY_REQUEST_BUDGET=2000

# ===== Pro subscription: manual payment (no card processor) =====
# Monthly price in ILS (default 9.9). Yearly price is optional: if unset, no
# yearly offer is shown at all (no invented discount).
# PRO_PRICE_MONTHLY=9.9
# PRO_PRICE_YEARLY=
# Real payment details only. If none of BIT_PAYMENT_URL /
# PAYBOX_PAYMENT_URL is set, the app shows "contact us" instead of payment info.
# BIT_PAYMENT_URL=https://...   (Bit/PayBox payment link; the QR is generated from it)
# PAYBOX_PAYMENT_URL=https://...

# Free Pro months granted to every NEW signup (0 = off, default 3).
# TRIAL_MONTHS=3
# Bank transfer (optional, all three required together)
# BANK_NAME=
# BANK_BRANCH=
# BANK_ACCOUNT=
