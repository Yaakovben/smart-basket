# ===================================
# Smart Basket Client - Environment Variables
# ===================================
# Copy this file to .env and fill in your values
# Note: All variables must start with VITE_ to be exposed to the client

# ─────────────────────────────────────
# API Server
# ─────────────────────────────────────
# API server URL (include /api at the end)
# Local: http://localhost:5000/api
# Prod: https://smartbasket-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# ─────────────────────────────────────
# Socket Server
# ─────────────────────────────────────
# Socket.io server URL for real-time updates
# Local: http://localhost:5001
# Prod: https://smartbasket-socket.onrender.com
#
# Leave this UNSET in a deployed environment (e.g. non-prod/staging) that
# intentionally has no socket server running - the client detects a missing
# value in a built (non-dev) app and skips connecting entirely instead of
# retrying forever against an unreachable localhost fallback. Real-time
# features (presence, live list updates) just stay off; REST features work
# normally. Only set this to localhost for local development.
VITE_SOCKET_URL=http://localhost:5001

# ─────────────────────────────────────
# Authentication
# ─────────────────────────────────────
# Google OAuth Client ID
# Get from: https://console.cloud.google.com/apis/credentials
# Optional: has fallback in code
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─────────────────────────────────────
# Product Photos - Cloudinary (Optional but recommended)
# ─────────────────────────────────────
# Lets users attach a photo to a product. When these are set, photos upload
# straight from the browser to Cloudinary and only a short https URL is stored
# on the product. When UNSET, the app falls back to storing a compressed
# data-URL inside the product document itself (works out of the box, but
# bloats the list API response - fine for dev / small usage only).
#
# Setup:
#   1. Create a free account at https://cloudinary.com
#   2. Settings > Upload > add an "Unsigned" upload preset
#   3. Put your cloud name + the preset name below
# VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
# VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# ─────────────────────────────────────
# Error Monitoring (Optional)
# ─────────────────────────────────────
# Sentry DSN for client-side error tracking
# Get from: sentry.io - Create a React project
# Only sends errors when running in production build (npm run build)
# VITE_SENTRY_DSN=https://xxxxx@oxxxxx.ingest.sentry.io/xxxxx
